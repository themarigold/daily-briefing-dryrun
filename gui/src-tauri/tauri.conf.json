{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Briefing",
  "version": "../package.json",
  "identifier": "com.themarigold.daily-briefing",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bash scripts/build-sidecar.sh && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daily Briefing",
        "width": 900,
        "height": 640,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE"
    },
    "externalBin": ["binaries/daily-briefing"],
    "category": "DeveloperTool",
    "shortDescription": "Local-first morning briefing",
    "longDescription": "Desktop shell for the daily-briefing engine. Spawns the engine as a sidecar and speaks argv plus stdout; it has no network origin of its own."
  }
}
