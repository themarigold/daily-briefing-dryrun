  - (commit) [a1a1a1a] fix(queue): retry path reworked twice — files: queue.py, retry.py — 2026-09-23
  - (commit) [b2b2b2b] feat(queue): retry backoff added — files: queue.py — 2026-09-23
  - (commit) [c3c3c3c] feat(queue): retry backoff tuned — files: tests/test_queue.py, docs/queue.md, config.py, queue.py — 2026-09-23
  - (commit) [d4d4d4d] feat(quant): sharpe ratio guard — files: quant_stocks/guard.py — 2026-09-23
  - (commit) [e5e5e5e] chore(queue): deadbeef1 landed — files: queue.py — 2026-09-23
